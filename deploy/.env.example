# ============================================================================
#  Gazi Portfolio - local Docker stack configuration
#
#  Copy to .env with:   portfolio-deploy.ps1 -Action env
#  Reserved ports are registered in the workspace SERVER_COMMANDS.md.
#  NEVER commit the real .env - only this example.
#
#  ASCII only on purpose: Windows PowerShell 5.1 reads text files as ANSI
#  unless they carry a UTF-8 BOM, so non-ASCII comments here turn into mojibake
#  in the generated .env.
# ============================================================================

# ---------------------------------------------------------------- compose ---
COMPOSE_PROJECT_NAME=gazi-portfolio

# Host ports. 8023 / 5436 are reserved for this project and are free on this
# machine (taken: 8002 8003 8010 8011 8012 8020 8021 8022 8088 8090 8091 8095
# 8096 3310 3395 27017 5173 5174 5433 5435).
WEB_PORT=8023
POSTGRES_PORT=5436

# -------------------------------------------------------------- database ---
POSTGRES_DB=gazi_portfolio
POSTGRES_USER=portfolio
# Required - the stack refuses to start without it. Change this.
POSTGRES_PASSWORD=change-me-local-postgres

# Consumed by the app container. Note the host is the compose service name.
DATABASE_URL=postgresql://portfolio:change-me-local-postgres@postgres:5432/gazi_portfolio

# ------------------------------------------------------------------ site ---
SITE_URL=http://localhost:8023
SITE_NAME=Gazi Monir-Uz-Zaman

# ------------------------------------------------------------------ auth ---
# Signs the admin session cookie. Minimum 32 characters.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-48-byte-random-string-please

# Seeded once by `-Action seed` as the admin login. He can change the password
# from /admin afterwards. Leave ADMIN_PASSWORD empty to skip seeding a user.
ADMIN_EMAIL=ciphercall@gmail.com
ADMIN_NAME=Gazi Monir-Uz-Zaman
ADMIN_PASSWORD=change-me-admin-login

# ----------------------------------------------------------------- media ---
# Inside the container. Backed by the `portfolio-media` named volume.
MEDIA_ROOT=/srv/media

# ------------------------------------------------------------- provenance ---
# Stamped by deploy/scripts/set-git-build-args.ps1 before each build.
GIT_SHA=

# ============================================================================
#  OPTIONAL - social publishing
#
#  Without SOCIAL_TOKEN_KEY the OAuth connect flow REFUSES to store a token
#  rather than persisting it in plaintext. The manual share links in the admin
#  panel keep working either way, so nothing here blocks the site.
# ============================================================================

# AES-256-GCM key for social tokens at rest. Minimum 32 characters.
# Generate with:  openssl rand -base64 32
SOCIAL_TOKEN_KEY=

# LinkedIn - requires your own app with the "Share on LinkedIn" product.
# Redirect URI to register:  {SITE_URL}/api/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta - posting targets a Facebook PAGE (personal profiles cannot be posted to
# by any API). Redirect URI:  {SITE_URL}/api/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
